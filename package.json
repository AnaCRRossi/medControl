{
  "name": "medcontrol",
  "version": "1.0.0",
  "description": "API REST para controle de medicamentos com prescrições e registros de uso",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "test:verbose": "jest --verbose",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "docker:build": "docker build -t medcontrol:latest .",
    "docker:run": "docker run -p 3000:3000 medcontrol:latest",
    "docker:compose:up": "docker-compose up -d",
    "docker:compose:down": "docker-compose down",
    "docker:compose:logs": "docker-compose logs -f"
  },
  "keywords": [
    "medicamentos",
    "prescrição",
    "saúde",
    "api",
    "rest"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "uuid": "^9.0.0",
    "jsonwebtoken": "^9.0.0",
    "dotenv": "^16.0.3",
    "express-validator": "^7.0.0",
    "bcryptjs": "^2.4.3"
  },
  "devDependencies": {
    "nodemon": "^2.0.22",
    "jest": "^29.5.0",
    "supertest": "^6.3.3",
    "eslint": "^8.44.0"
  }
}
